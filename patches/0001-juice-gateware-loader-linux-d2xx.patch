 FT_HANDLE ftHandle;
 
+/* Read the live pin levels of channel B. In async bit-bang mode the Linux
+ * D2XX FT_Read returns no pin samples, which left the status loops polling
+ * an uninitialised byte. */
+static int read_prog_pins(unsigned char *pins) {
+	return FT_GetBitMode(ftHandle, pins) == FT_OK ? 0 : -1;
+}
+
+/* When channel A is left in FT245 synchronous FIFO mode (a previous run of
+ * this program), the FT2232H disables channel B and every bit-bang write is
+ * silently ignored: the FPGA is never (re)programmed. Reset channel A first. */
+static void release_stream_channel() {
+	FT_HANDLE ftHandleA;
+	if (FT_OpenEx((void**)"radioberry-juice A", FT_OPEN_BY_DESCRIPTION, &ftHandleA) != FT_OK) return;
+	FT_SetBitMode(ftHandleA, 0, 0);
+	FT_Close(ftHandleA);
+	usleep(100000);
+}
+
 int init_gateware_ftdi() {
 
 	printf("Init device for loading gateware...\r\n");
 
 	FT_STATUS ftStatus = FT_OK;
 
+	release_stream_channel();
+
 	ftStatus = FT_OpenEx((void**)"radioberry-juice B", FT_OPEN_BY_DESCRIPTION, &ftHandle);
 	
 	if (ftStatus == FT_OK)
